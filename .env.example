# Copy to .env for local development. On Streamlit Community Cloud, put the same keys in
# App settings -> Secrets. Never commit a real .env file.

# Administrator account (created once at first start). Use a strong, unique password.
ADMIN_EMAIL=admin@your-clinic.example
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=System Administrator

# Demo data for testing and demonstrations (doctors, a demo patient, sample appointments).
# Set SEED_DEMO_DATA=false for a clean production-style database.
SEED_DEMO_DATA=true
# Leave empty to disable demo accounts entirely. Use a unique password if you enable them.
DEMO_PASSWORD=change-me-demo-password

# SQLite location (relative to the project folder)
DATABASE_PATH=data/healthcarex.db
